{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnforcePi05InstanceDeadlines",
      "Effect": "Allow",
      "Action": [
        "ec2:StopInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-2:752160877725:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "pi05-aws-repro"
        }
      }
    }
  ]
}
