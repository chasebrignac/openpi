# Combined TensorRT 11 engine runtime plus the minimal OpenPI transform and
# WebSocket policy stack. The compiler image must first be built from the same
# reviewed source commit and mirrored into the project account's ECR.
ARG TENSORRT_COMPILER_IMAGE
FROM ${TENSORRT_COMPILER_IMAGE}

ARG TENSORRT_COMPILER_IMAGE
ARG SOURCE_SHA
ARG TENSORRT_COMPILER_SOURCE_SHA
ARG OPENPI_SHA=15a9616a00943ada6c20a0f158e3adb39df2ccac
ARG TENSORRT_VERSION=11.0.0.114
ARG CUDA_VERSION=13.3.0
ARG MODELOPT_VERSION=0.45.0
ARG TORCH_VERSION=2.8.0
ARG ONNX_VERSION=1.21.0
ARG ONNXRUNTIME_GPU_VERSION=1.24.2
ARG UV_LOCK_SHA256=793488b5a55bb87200db90a61fd0af51922b686d94e1da4f4c587ab119b37d74
ARG PALIGEMMA_TOKENIZER_SHA256=8986bb4f423f07f8c7f70d0dbe3526fb2316056c17bae71b1ea975e77a168fc6
ARG LEROBOT_RUNTIME=v2
ARG LEROBOT_SHA
ARG LEROBOT_V2_SHA=0cf864870cf29f4738d3ade893e6fd13fbd7cdb5
ARG LEROBOT_V3_SHA=0b067df57d21d3a02d6c511f1609172fa39ac29b

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/cache/huggingface \
    OPENPI_DATA_HOME=/opt/openpi-cache \
    PYTHONPATH=/workspace/openpi/src:/workspace/openpi/packages/openpi-client/src:/opt/openpi/src:/opt/openpi/packages/openpi-client/src \
    PATH=/opt/modelopt/bin:/opt/tensorrt/bin:${PATH} \
    JAX_PLATFORMS=cpu \
    XLA_PYTHON_CLIENT_PREALLOCATE=false \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

# Docker cannot introspect a parent image's OCI labels from inside a build.
# The publication command must read the parent labels and pass that exact
# revision as TENSORRT_COMPILER_SOURCE_SHA; the equality below prevents an
# accidental cross-commit composition and the final image preserves both
# claims for an independent post-build inspection.
RUN printf '%s\n' "${TENSORRT_COMPILER_IMAGE}" \
      | grep -Eq '^752160877725\.dkr\.ecr\.us-east-2\.amazonaws\.com/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$' \
    && printf '%s\n' "${SOURCE_SHA}" | grep -Eq '^[0-9a-f]{40}$' \
    && printf '%s\n' "${TENSORRT_COMPILER_SOURCE_SHA}" | grep -Eq '^[0-9a-f]{40}$' \
    && test "${SOURCE_SHA}" = "${TENSORRT_COMPILER_SOURCE_SHA}" \
    && test "${TENSORRT_VERSION}:${CUDA_VERSION}:${MODELOPT_VERSION}:${TORCH_VERSION}:${ONNX_VERSION}:${ONNXRUNTIME_GPU_VERSION}" \
      = "11.0.0.114:13.3.0:0.45.0:2.8.0:1.21.0:1.24.2" \
    && command -v trtexec >/dev/null \
    && /opt/modelopt/bin/python -c "import modelopt, onnx, onnxruntime, tensorrt, torch; actual = (tensorrt.__version__, modelopt.__version__, torch.__version__.split('+', 1)[0], onnx.__version__, onnxruntime.__version__); expected = ('${TENSORRT_VERSION}', '${MODELOPT_VERSION}', '${TORCH_VERSION}', '${ONNX_VERSION}', '${ONNXRUNTIME_GPU_VERSION}'); assert actual == expected, (actual, expected)" \
    && test -x "$(command -v trtexec)"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -m 0777 /cache

WORKDIR /opt/openpi

# Seal the complete regular-file tree inherited from the compiler. Comparing
# it after the final COPY catches a compiler/policy context mismatch in
# addition to the explicit parent/source revision-label equality above.
RUN LC_ALL=C find . -type f -print0 \
      | LC_ALL=C sort -z \
      | xargs -0 sha256sum > /tmp/parent-openpi-source.sha256

# Dependency metadata is copied before source. Runtime dependency and tokenizer
# layers are therefore shared by the v2/v3 builds and survive ordinary source
# edits whenever the parent compiler digest remains unchanged.
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY packages/openpi-client/pyproject.toml packages/openpi-client/pyproject.toml

# Export the production dependency graph from the frozen lock, pruning training,
# dataset, telemetry, and media branches not used by the engine-backed policy.
# Reuse the compiler venv's TensorRT/ModelOpt/Torch/ONNX/ORT/CUDA stack instead
# of allowing OpenPI's CUDA-12 training lock to replace the CUDA-13.3 toolchain.
RUN echo "${UV_LOCK_SHA256}  uv.lock" | sha256sum --check --strict \
    && printf '%s\n' \
      jax-cuda12-pjrt jax-cuda12-plugin ml-dtypes \
      modelopt nvidia-modelopt onnx onnxruntime onnxruntime-gpu \
      torch torchcodec torchvision triton \
      nvidia-cublas-cu12 nvidia-cuda-cupti-cu12 nvidia-cuda-nvcc-cu12 \
      nvidia-cuda-nvrtc-cu12 nvidia-cuda-runtime-cu12 nvidia-cudnn-cu12 \
      nvidia-cufft-cu12 nvidia-cufile-cu12 nvidia-curand-cu12 \
      nvidia-cusolver-cu12 nvidia-cusparse-cu12 nvidia-cusparselt-cu12 \
      nvidia-nccl-cu12 nvidia-nvjitlink-cu12 nvidia-nvtx-cu12 \
      > /tmp/compiler-provided-requirements.txt \
    && uv export --frozen --no-dev --no-emit-workspace \
      --prune lerobot --prune gcsfs --prune gym-aloha --prune imageio \
      --prune opencv-python --prune polars --prune wandb \
      --output-file /tmp/openpi-policy-locked-requirements.txt \
    && uv pip install --python /opt/modelopt/bin/python --no-cache-dir \
      --requirements /tmp/openpi-policy-locked-requirements.txt \
      --excludes /tmp/compiler-provided-requirements.txt \
      --require-hashes \
    && rm -f /tmp/compiler-provided-requirements.txt /tmp/openpi-policy-locked-requirements.txt

# The transform path always resolves this hard-coded gs:// tokenizer identity.
# Cache and verify it before the LeRobot/source-specific layers so serving with
# --network none never resolves mutable remote tokenizer bytes.
RUN mkdir -p "${OPENPI_DATA_HOME}/big_vision" \
    && curl --fail --location --silent --show-error \
      https://storage.googleapis.com/big_vision/paligemma_tokenizer.model \
      --output "${OPENPI_DATA_HOME}/big_vision/paligemma_tokenizer.model" \
    && echo "${PALIGEMMA_TOKENIZER_SHA256}  ${OPENPI_DATA_HOME}/big_vision/paligemma_tokenizer.model" \
      | sha256sum --check --strict \
    && chmod 0777 "${OPENPI_DATA_HOME}" "${OPENPI_DATA_HOME}/big_vision" \
    && chmod 0444 "${OPENPI_DATA_HOME}/big_vision/paligemma_tokenizer.model"

# TensorRT serving never opens a LeRobot dataset, so install only the exact
# source package without its training/video dependency tree. Labels still make
# the v2 LIBERO and v3 DROID runtime variants unambiguous and fail closed.
RUN case "${LEROBOT_RUNTIME}:${LEROBOT_SHA}" in \
      "v2:${LEROBOT_V2_SHA}") EXPECTED_LEROBOT_VERSION=0.1.0 ;; \
      "v3:${LEROBOT_V3_SHA}") EXPECTED_LEROBOT_VERSION=0.4.3 ;; \
      *) echo "LeRobot runtime/revision pair is not the pinned reproduction pair" >&2; exit 2 ;; \
    esac \
    && uv pip install --python /opt/modelopt/bin/python --no-cache-dir --no-deps \
      "lerobot @ git+https://github.com/huggingface/lerobot.git@${LEROBOT_SHA}" \
    && LEROBOT_EXPECTED_VERSION="${EXPECTED_LEROBOT_VERSION}" /opt/modelopt/bin/python -c \
      "import importlib.metadata as m, os; import lerobot; actual = m.version('lerobot'); expected = os.environ['LEROBOT_EXPECTED_VERSION']; assert actual == expected, (actual, expected); print(lerobot, actual)"

# Source is deliberately the final large COPY. Install both workspace packages
# without dependency resolution into the inherited /opt/modelopt environment.
COPY . /opt/openpi
RUN printf '%s\n' "${SOURCE_SHA}" | grep -Eq '^[0-9a-f]{40}$' \
    && LC_ALL=C find . -type f -print0 \
      | LC_ALL=C sort -z \
      | xargs -0 sha256sum > /tmp/policy-openpi-source.sha256 \
    && cmp /tmp/parent-openpi-source.sha256 /tmp/policy-openpi-source.sha256 \
    && uv pip install --python /opt/modelopt/bin/python --no-cache-dir --no-deps \
      /opt/openpi/packages/openpi-client /opt/openpi \
    && TRANSFORMERS_DIR="$(/opt/modelopt/bin/python -c 'import pathlib, transformers; print(pathlib.Path(transformers.__file__).parent)')" \
    && cp -r src/openpi/models_pytorch/transformers_replace/* "${TRANSFORMERS_DIR}/"

# These checks are imports and CPU-only transform/tokenizer checks. They do not
# deserialize an engine, initialize CUDA, or claim GPU validation; that happens
# only on the target g7e worker with the sealed engine/runtime identity.
RUN /opt/modelopt/bin/python -c "import importlib.metadata as m, modelopt, onnx, onnxruntime, tensorrt, torch; expected = {'flax': '0.10.2', 'jax': '0.5.3', 'numpy': '1.26.4', 'onnx': '${ONNX_VERSION}', 'onnxruntime-gpu': '${ONNXRUNTIME_GPU_VERSION}', 'openpi': '0.1.0', 'openpi-client': '0.1.0', 'sentencepiece': '0.2.0', 'torch': '${TORCH_VERSION}', 'transformers': '4.53.2', 'tyro': '0.9.22', 'websockets': '15.0.1'}; actual = {name: m.version(name).split('+', 1)[0] for name in expected}; assert actual == expected, (actual, expected); assert tensorrt.__version__ == '${TENSORRT_VERSION}'; assert modelopt.__version__ == '${MODELOPT_VERSION}'; assert onnx.__version__ == '${ONNX_VERSION}'; assert onnxruntime.__version__ == '${ONNXRUNTIME_GPU_VERSION}'; print(actual)" \
    && /opt/modelopt/bin/python -c "from openpi.exporting import tensorrt_policy; from openpi.models.tokenizer import PaligemmaTokenizer; from openpi.serving.websocket_policy_server import WebsocketPolicyServer; from openpi.training import config; from openpi_client import base_policy, msgpack_numpy; tokenizer = PaligemmaTokenizer(48); tokens, mask = tokenizer.tokenize('runtime smoke'); assert tokens.shape == mask.shape == (48,); assert config.get_config('pi05_libero_l09_snapflow').name == 'pi05_libero_l09_snapflow'; assert config.get_config('pi05_droid_l09_snapflow').name == 'pi05_droid_l09_snapflow'; print(tensorrt_policy.TensorRTPolicy, WebsocketPolicyServer, base_policy.BasePolicy, msgpack_numpy.Packer)"

LABEL org.opencontainers.image.revision=${SOURCE_SHA}
LABEL ai.openpi.upstream-revision=${OPENPI_SHA}
LABEL ai.openpi.image-purpose="tensorrt-policy"
LABEL ai.openpi.parent-image-purpose="tensorrt-compiler"
LABEL ai.openpi.parent-tensorrt-compiler-image="${TENSORRT_COMPILER_IMAGE}"
LABEL ai.openpi.parent-tensorrt-compiler-source-revision=${TENSORRT_COMPILER_SOURCE_SHA}
LABEL ai.openpi.tensorrt-version=${TENSORRT_VERSION}
LABEL ai.openpi.cuda-version=${CUDA_VERSION}
LABEL ai.openpi.modelopt-version=${MODELOPT_VERSION}
LABEL ai.openpi.torch-version=${TORCH_VERSION}
LABEL ai.openpi.onnx-version=${ONNX_VERSION}
LABEL ai.openpi.onnxruntime-gpu-version=${ONNXRUNTIME_GPU_VERSION}
LABEL ai.openpi.runtime-lock-sha256=${UV_LOCK_SHA256}
LABEL ai.openpi.policy-runtime="openpi-transform-websocket"
LABEL ai.openpi.policy-python="/opt/modelopt/bin/python"
LABEL ai.openpi.policy-protocol="openpi-policy-websocket-v1"
LABEL ai.openpi.lerobot-runtime=${LEROBOT_RUNTIME}
LABEL ai.openpi.lerobot-revision=${LEROBOT_SHA}
LABEL ai.openpi.paligemma-tokenizer-sha256=${PALIGEMMA_TOKENIZER_SHA256}
LABEL org.opencontainers.image.title="pi05-aws-repro-tensorrt-policy"

ENTRYPOINT []
CMD ["bash"]
